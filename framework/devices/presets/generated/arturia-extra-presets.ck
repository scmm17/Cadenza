public class AugmentedVoicesPresetCollection extends PresetCollection
{
    fun AugmentedVoicesPresetCollection()
    {
        initItems(AugmentedVoicesPresetsData.items);
        1 => preferCurrentCategory;
        0 => matchCode;
    }
}

